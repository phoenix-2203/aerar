{
  "name": "aerar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "scenarios": "node --import tsx scripts/scenarios.ts",
    "test:scenarios": "vitest run src/lib/scenarios",
    "night-shift": "node --import tsx scripts/night-shift.ts",
    "screenshots": "node --env-file-if-exists=.env --import tsx scripts/screenshots.ts",
    "smoke": "node scripts/smoke-live.mjs",
    "seed:sim": "node --env-file-if-exists=.env --import tsx scripts/seed-sim.ts",
    "escrow:demo": "node --env-file-if-exists=.env --import tsx scripts/escrow-demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/next": "2.28.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
