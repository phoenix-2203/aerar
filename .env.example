# Aerar environment. Copy to .env and fill in. TESTNET ONLY: this build settles on Base Sepolia and has no mainnet mode.
# Never commit .env. Never paste these values into chats, issues or logs.

# --- Database ---
# Postgres connection string. Leave unset to use embedded PGlite (a local folder, fine for development and single-instance demos).
DATABASE_URL=
# Where PGlite stores its data when DATABASE_URL is unset. Default: ./.data/pglite
PGLITE_DIR=

# --- Paying side (Aerar's wallet) ---
# Private key of the Base Sepolia wallet Aerar pays from. Agents never see it. Generate a fresh one; fund it with test USDC from faucet.circle.com.
PAYER_PRIVATE_KEY=
# Base Sepolia JSON-RPC URL used to read payment receipts. Optional; defaults to the public endpoint (rate-limited).
BASE_SEPOLIA_RPC_URL=

# --- Demo provider (the paid endpoints under /api/demo) ---
# Address that receives payments for the demo endpoints. Any Base Sepolia address; it only receives.
DEMO_PAYTO_ADDRESS=
# Host the seed script puts on the demo task's provider allowlist, e.g. localhost:3000 or aerar.example.xyz
DEMO_PROVIDER_HOST=localhost:3000
# x402 facilitator. The public x402.org facilitator works on testnet with no API key.
# "local" verifies and settles in-process with the x402 library (gas paid by PAYER_PRIVATE_KEY); needed for Vault
# payments, because the library checks contract-wallet (ERC-1271) signatures.
X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Aerar Vault (optional) ---
# Factory for user-owned Vaults on Base Sepolia. Deploy with: node scripts/deploy-vault-factory.mjs
VAULT_FACTORY_ADDRESS=
# Morning Seal contract (deployed by the same script) and the secret the daily cron sends.
#   crontab: 5 6 * * * curl -s -H "authorization: Bearer $CRON_SECRET" https://your-host/api/cron/seal
SEAL_ADDRESS=
CRON_SECRET=

# --- Operator dashboard ---
# Password for the operator login. Use a long random value.
OPERATOR_PASSWORD=
# Secret used to sign the operator session cookie (32+ random characters). Changing it logs everyone out.
SESSION_SECRET=

# --- Development ---
# Set to 1 to let agents buy from http:// URLs (needed for localhost). Leave unset in production.
AERAR_ALLOW_INSECURE_HTTP=
# Organisation the operator password unlocks. The seed script creates org_demo.
AERAR_ORG_ID=org_demo

# Refunds: the Escrow factory and the demo shop's escrow (deploy/vps/setup-escrow.sh fills these in)
ESCROW_FACTORY_ADDRESS=
DEMO_ESCROW_ADDRESS=
