# Copy to deploy/.env ON THE VPS and fill in there. Never commit it, never paste these values into chats.
# TESTNET ONLY: Base Sepolia.

# Your DuckDNS name, e.g. aerar.duckdns.org (must point at this VPS's IP)
AERAR_DOMAIN=
# Long random value: openssl rand -hex 24
POSTGRES_PASSWORD=

# Fresh Base Sepolia wallet holding only test USDC (faucet.circle.com)
PAYER_PRIVATE_KEY=
# Optional; defaults to the public (rate-limited) endpoint
BASE_SEPOLIA_RPC_URL=
# Any Base Sepolia address; it only receives demo payments
DEMO_PAYTO_ADDRESS=
X402_FACILITATOR_URL=https://x402.org/facilitator

# Operator login: long random values (openssl rand -hex 24)
OPERATOR_PASSWORD=
SESSION_SECRET=
AERAR_ORG_ID=org_demo
